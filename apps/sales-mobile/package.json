{
  "name": "@synera/sales-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "iphone": "node scripts/iphone.mjs",
    "gateway": "node scripts/mobile-gateway.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 5173 --host localhost",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "build:ios": "npx eas-cli@latest build --platform ios --profile unsigned",
    "build:ios:signed": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:store": "npx eas-cli@latest build --platform ios --profile production",
    "ios:register": "npx eas-cli@latest device:create"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  }
}
