{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "unsigned": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://facility-weapon-tutorials-kenneth.trycloudflare.com"
      },
      "ios": {
        "simulator": false,
        "withoutCredentials": true,
        "config": "ios-unsigned.yml"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://172.30.84.160:5173"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": { "simulator": false }
    }
  }
}
